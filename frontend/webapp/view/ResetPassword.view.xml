<mvc:View controllerName="harbest.controller.ResetPassword"
	xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m">
	<Page showHeader="false">
		<VBox class="sapUiMediumMargin" width="20rem">
			<Title text="{i18n>resetTitle}" />
			<Input id="token" placeholder="{i18n>resetToken}" liveChange=".onInputChange" />
			<Input id="password" type="Password" placeholder="{i18n>resetNewPassword}" liveChange=".onInputChange" />
			<Input id="confirm" type="Password" placeholder="{i18n>registerConfirm}" liveChange=".onInputChange" />
			<Button text="{i18n>resetButton}" type="Emphasized" press=".onReset" />
			<Link text="{i18n>forgotBack}" press=".onGoLogin" />
		</VBox>
	</Page>
</mvc:View>