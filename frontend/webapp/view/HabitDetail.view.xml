<mvc:View
    controllerName="harbest.controller.HabitDetail"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc">
    <Page title="{/name}" showNavButton="true" navButtonPress=".onNavBack">
        <content>
            <VBox class="sapUiMediumMargin">
                <Text text="Stage: {/growthStage}"/>
                <Text text="XP: {= Math.round(${/totalExperience})}"/>
                <Text text="Day Streak: {/streak}"/>
                <Text text="Daily Objetive Time : {/dailyObjectiveTime} min"/>
                <ProgressIndicator
                percentValue="{= Math.min(100, ${/minutesDoneToday} / ${/dailyObjectiveTime} * 100)}"
                displayValue="{/minutesDoneToday} / {/dailyObjectiveTime} min"
                state="{= ${/minutesDoneToday} >= ${/dailyObjectiveTime} ? 'Success' : 'Information'}"
                showValue="true"
                width="80%"
                class="sapUiSmallMarginTop"/>

                <Text text="{= ${/minutesDoneToday} >= ${/dailyObjectiveTime} ? 'Objective completed today ✓' : 'Objective not completed yet'}"/>
                <Button text="Water" icon="sap-icon://watering-can" type="Emphasized" press=".onOpenWaterDialog" class="sapUiSmallMarginTop"/>
                <Text text="Last 7 days" class="sapUiSmallMarginTop sapUiMediumMarginBottom"/>
                <List items="{weekly>/}">
                    <StandardListItem title="{weekly>date}" info="{weekly>duration} min"/>
                </List>
            </VBox>
        </content>
    </Page>
</mvc:View>