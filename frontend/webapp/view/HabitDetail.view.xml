<mvc:View
    controllerName="harbest.controller.HabitDetail"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc">
    <Page title="{/name}" showNavButton="true" navButtonPress=".onNavBack">
    <headerContent>
        <Text text="{user>/username}" class="sapUiTinyMarginEnd"/>
        <Button icon="sap-icon://log" tooltip="{i18n>mainLogout}" press=".onLogout" />
    </headerContent>

    <content>
        <VBox class="sapUiMediumMargin">
            <Text text="{i18n>detailStage}: {path: '/growthStage', formatter: '.formatStage'}"/>
            <Text text="{i18n>detailXp}: {= Math.round(${/totalExperience})}"/>
            <Text text="{i18n>detailStreak}: {/streak}"/>
            <Text text="{i18n>detailDailyObjective}: {/dailyObjectiveTime} {i18n>detailMinutesShort}"/>
            <ProgressIndicator
                percentValue="{= Math.min(100, ${/minutesDoneToday} / ${/dailyObjectiveTime} * 100)}"
                displayValue="{/minutesDoneToday} / {/dailyObjectiveTime} {i18n>detailMinutesShort}"
                state="{= ${/minutesDoneToday} >= ${/dailyObjectiveTime} ? 'Success' : 'Information'}"
                showValue="true"
                width="80%"
                class="sapUiSmallMarginTop"/>

            <Text text="{= ${/minutesDoneToday} >= ${/dailyObjectiveTime} ? ${i18n>detailObjectiveDone} : ${i18n>detailObjectivePending}}"/>
            <Button text="{i18n>detailWater}" icon="sap-icon://watering-can" type="Emphasized" press=".onOpenWaterDialog" class="sapUiSmallMarginTop"/>
            <Text text="{i18n>detailLast7Days}" class="sapUiSmallMarginTop sapUiMediumMarginBottom"/>
            <HBox items="{weekly>/}" wrap="Wrap" justifyContent="SpaceBetween">
                <VBox alignItems="Center" class="sapUiSmallMarginEnd">
                    <Text text="{weekly>date}"/>
                    <ObjectNumber number="{weekly>duration}" unit="{i18n>detailMinutesShort}"/>
                </VBox>
            </HBox>
        </VBox>
    </content>
</Page>
</mvc:View>