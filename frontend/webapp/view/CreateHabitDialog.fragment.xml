<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog title="Create Habit" id="createHabitDialog">
        <content>
            <VBox class="sapUiSmallMargin">
                <Label text="Name" labelFor="habitNameInput"/>
                <Input id="habitNameInput" placeholder="Habit name"/>
                <Label text="Daily objective time (in minutes)" labelFor="habitTimeInput" class="sapUiSmallMarginTop"/>
                <Input id="habitTimeInput" type="Number" placeholder="30"/>
            </VBox>
        </content>
        <beginButton>
            <Button text="Create" type="Emphasized" press=".onConfirmCreateHabit"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onCancelCreateHabit"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>