<mvc:View controllerName="harbest.controller.Login"
	xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m">
	<Page showHeader="false">
		<VBox class="sapUiMediumMargin" width="20rem">
			<Title text="{i18n>loginTitle}" />
			<Input id="identifier" placeholder="{i18n>loginIdentifier}" liveChange=".onInputChange" />
			<Input id="password" type="Password" placeholder="{i18n>loginPassword}" liveChange=".onInputChange" />

			<Button text="{i18n>loginButton}" type="Emphasized" press=".onLogin" />
			<Link text="{i18n>login2Register}" press=".onGoRegister" />
		</VBox>
	</Page>
</mvc:View>