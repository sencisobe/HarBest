<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog title="Water Habit" id="waterHabitDialog">
        <content>
            <VBox class="sapUiSmallMargin">
                <Label text="Minutes Invested" labelFor="waterDurationInput"/>
                <Input id="waterDurationInput" type="Number" placeholder="30"/>
            </VBox>
        </content>
        <beginButton>
            <Button text="Water" type="Emphasized" press=".onConfirmWaterHabit"/>
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onCancelWaterHabit"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>