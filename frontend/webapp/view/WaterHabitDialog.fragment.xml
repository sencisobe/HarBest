<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog title="{i18n>waterTitle}" id="waterHabitDialog">
        <content>
            <VBox class="sapUiSmallMargin">
                <Label text="{i18n>waterMinutes}" labelFor="waterDurationInput"/>
                <Input id="waterDurationInput" type="Number" placeholder="30" liveChange=".onInputChange"/>
            </VBox>
        </content>
        <beginButton>
            <Button text="{i18n>detailWater}" type="Emphasized" press=".onConfirmWaterHabit"/>
        </beginButton>
        <endButton>
            <Button text="{i18n>commonCancel}" press=".onCancelWaterHabit"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>