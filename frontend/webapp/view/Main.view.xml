<mvc:View
	controllerName="harbest.controller.Main"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	core:require="{
		formatter: 'harbest/model/formatter'
	}">

	<Page
		title="{i18n>appTitle}"
		id="page">
		<content>
		
			<VBox alignItems="Center" class="sapUiMediumMargin">
				<Image src="images/cartoon-illustration-of-a-tree-with-green-leaves-free-png.webp" width="150px" class="sapUiSmallMarginBottom"/>
				<Title text="{i18n>appTitle}" level="H1"/>
				<Text text="{i18n>appDescription}" class="sapUiTinyMarginTop"/>
			</VBox>
			
			<Button text="Create habit" press=".onOpenCreateDialog" icon="sap-icon://add" class="sapUiSmallMarginBottom"/>

			<List items="{/}">
				<CustomListItem type="Navigation" press=".onHabitPress">
					<HBox justifyContent="SpaceBetween" alignItems="Center" width="100%">
						<VBox>
							<Text text="{name}"/>
							<Text text="{growthStage} - {= Math.round(${totalExperience})} XP"/>
						</VBox>
						<Button icon="sap-icon://delete" press="onDeleteHabit" type="Reject"/>
					</HBox>
				</CustomListItem>
			</List>
		</content>
	</Page>

</mvc:View>
