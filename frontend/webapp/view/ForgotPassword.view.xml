<mvc:View controllerName="harbest.controller.ForgotPassword"
	xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m">
	<Page showHeader="false">
		<VBox class="sapUiMediumMargin" width="20rem">
			<Title text="{i18n>forgotTitle}" />
			<Text text="{i18n>forgotInfo}" class="sapUiTinyMarginBottom"/>
			<Input id="identifier" placeholder="{i18n>loginIdentifier}" liveChange=".onInputChange" />
			<Button text="{i18n>forgotButton}" type="Emphasized" press=".onSend" />
			<Link text="{i18n>forgotBack}" press=".onGoLogin" />
		</VBox>
	</Page>
</mvc:View>